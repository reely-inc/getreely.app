---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-circle.png';
import hero from '../assets/hero.png';
import getReely from '../assets/get-reely-app.png';
import { Image } from 'astro:assets';
import EarlyAccessButton from '../components/EarlyAccessButton.jsx';

// Define meta information for this page
const title = "Reely App - Async Video Chat";
const description = "Reely App is a mobile-first platform for async video chat. Download Reely App today and experience the future of video communication.";
const image = hero.src;
---

<style>
	body {
		background-color: #060a13;
		color: #fff;
		font-family: 'Roboto', sans-serif;
		margin: 20;
		padding: 20px;
		box-sizing: border-box;
	}

	.top-bar {
		top: 0;
		left: 0;
		width: 96%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 20px;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
		z-index: 1000;
	}

	.top-bar img {
		width: 126px;
		height: 126px;
	}

	section {
		text-align: center;
		margin-bottom: 0px;
	}

	section + section {
		margin-top: 60px;
	}

	h1, h2 {
		color: #f9c07d;
		margin-bottom: 20px;
	}

	p {
		line-height: 1.8;
		font-size: 1.1rem;
		margin: 10px 0;
	}

	a {
		color: #f9c07d;
		text-decoration: none;
		font-weight: bold;
		font-size: 1.1rem;
	}

	a:hover {
		text-decoration: underline;
	}

	.hero {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 20px;
		flex-direction: row;
		max-width: 900px;
		margin: 30px auto 0;
		width: 100%;
		margin-bottom: 60px;
	}

	.hero div {
		/* height: 300px; */
		display: flex;
		align-items: left;
		justify-content: left;
		color: #fff;
		font-size: 1.5rem;
	}

	.hero-content {
		text-align: left;
		color: #fff;
		display: flex;
		flex-direction: column;
		gap: 10px;
		align-items: flex-start;
	}

	.hero-content h1 {
		color: #f9c07d;
		margin-bottom: 20px;
	}

	.hero-content p {
		line-height: 1.8;
		font-size: 1.1rem;
		margin: 10px 0;
	}

	.hero img {
		width: 500px;
		height: 359px;
	}

	.container .early-access {
		margin-top: 0px;
	}

	.container .early-access img {
		max-width: 100%;
		height: auto;
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 100vh;
		width: 100%;
		box-sizing: border-box;
		text-align: center;
		align-items: center;
	}

	@media (max-width: 768px) {
		.hero {
			flex-direction: column;
			align-items: center;
		}

		.hero img {
			width: 100%;
			height: auto;
		}

		.hero-content {
			text-align: center;
			align-items: center;
		}
	}

	@media (max-width: 480px) {
		body {
			padding: 10px;
		}

		.top-bar {
			flex-direction: column;
			align-items: center;
			padding: 10px;
		}

		.top-bar img {
			width: 80px;
			height: 80px;
		}

		.hero {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		.hero img {
			width: 100%;
			height: auto;
		}

		.hero-content {
			align-items: center;
		}

		.hero-content h1 {
			font-size: 1.5rem;
		}

		.hero-content p {
			font-size: 1rem;
		}

		.container {
			padding: 0 10px;
		}
	}
</style>

<Layout title={title} description={description} image={image}>
	<div class="top-bar">
		<Image src={logo} alt="Reely Logo" width={126} height={126} loading="eager" />
		<EarlyAccessButton client:only="react" />
	</div>
	<div class="container">

		<section class="hero">
			<div class="hero-content">
				<h1>Reely: Async Video Chat</h1>
				<div>
					<p>
						Reely is now live! Instantly connect with friends and family through quick, expressive video messages—anytime, anywhere. Experience the freedom of async video chat: record, reply, and keep the conversation flowing at your own pace. No more missed moments, just real connections.
					</p>
				</div>
			</div>
			<div>
				<p><Image src={hero} alt="Reely Hero" width={500} height={359} loading="eager" /></p>
			</div>
		</section>

		<section class="early-access">
			<h2>Download Reely Today!</h2>
			<p>
				Reely is officially available on the App Store and Google Play. Tap below to get started and join the next wave of video chat. 
				<br /><br />
				<b>Ready to vibe? Download now and start your first async video conversation!</b>
			</p>
			<div>
				<EarlyAccessButton type="image" client:only="react" />
			</div>
		</section>

		<section>
			<h2>The Reely Experience</h2>
			<p>
				Feel the energy of Reely! Explore our curated album and discover the sounds that set the mood for every conversation. Your vibe, your soundtrack—press play and dive in.
			</p>
			<div style="text-align: center; margin-top: 20px;">
				<iframe 
					width="100%" 
					height="300" 
					allow="autoplay" 
					title="The Reely Experience SoundCloud Player" 
					loading="lazy" 
					src="https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/reely-studios/sets/the-reely-experience&color=%23d75e91&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true">
				</iframe>
			</div>
		</section>
	</div>
</Layout>
